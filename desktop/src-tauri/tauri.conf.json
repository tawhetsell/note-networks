{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note Networks",
  "version": "0.1.0",
  "identifier": "com.notenetworks.app",
  "build": {
    "frontendDist": "../../viz",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Note Networks",
        "url": "graph.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --proxy-server=127.0.0.1:9"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: data: blob: 'unsafe-inline'; img-src 'self' tauri: data: blob:; connect-src 'self' tauri: ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
