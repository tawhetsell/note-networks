{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note Networks",
  "version": "0.1.0",
  "identifier": "com.notenetworks.app",
  "build": {
    "frontendDist": "../../viz",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Note Networks",
        "url": "graph.html",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' tauri: https: data: blob:; connect-src 'self' tauri: ipc: http://ipc.localhost https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
